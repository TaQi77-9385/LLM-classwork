{
  "entry": "main.py",
  "name": "TQAgent",
  "display_name": "TQAgent",
  "version": "1.0.0",
  "icon": "assets/icon.png",
  "pyinstaller": {
    "onefile": false,
    "windowed": false,
    "add_data": [
      "core:core",
      "tui:tui"
    ],
    "hidden_import": [
      "tui",
      "tui.app",
      "textual",
      "mcp",
      "mcp.client.stdio",
      "mcp.client.streamable_http"
    ],
    "clean": true,
    "noconfirm": true
  },
  "platforms": {
    "windows": {
      "inno_setup": {
        "create_desktop_icon": true,
        "create_start_menu_icon": true,
        "allow_run_after_install": true,
        "languages": [
          "chinesesimplified",
          "english"
        ]
      }
    }
  }
}