{
  "mcpServers": {
    "example-http": {
      "type": "streamable_http",
      "url": "https://example.com/mcp"
    },
    "example-stdio": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "your_mcp_server"],
      "env": {
        "API_KEY": "${API_KEY}"
      }
    }
  }
}
